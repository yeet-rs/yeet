  "query": "\n        SELECT\n            orl.id,\n            osn.host_identifier,\n            orl.unix_time,\n            orl.numerics as \"numerics: bool\",\n            orl.epoch,\n            orl.pack_name,\n            orl.log,\n            orl.counter,\n            orl.received_time as \"received_time: jiff_sqlx::Timestamp\"\n\n        FROM osquery_result_log orl\n        JOIN osquery_nodes osn on orl.node_id = osn.id\n        WHERE orl.splunk_status = $1",
