  "query": "\n        SELECT\n            t.host_id AS \"host_id: api::HostID\",\n            (SELECT h.state FROM host_task_history h\n             WHERE h.task_id = t.id\n             ORDER BY h.update_time DESC, h.id DESC\n             LIMIT 1) AS \"state!: api::TaskState\"\n        FROM host_tasks t\n        WHERE t.id = $1",
