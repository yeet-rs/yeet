{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            t.id AS \"id: api::TaskID\",\n            t.payload,\n            t.expires_at AS \"expires_at: jiff_sqlx::Timestamp\"\n        FROM host_tasks t\n        WHERE t.host_id = $1\n          AND (SELECT h.state FROM host_task_history h\n               WHERE h.task_id = t.id\n               ORDER BY h.update_time DESC, h.id DESC\n               LIMIT 1) = $2\n        ORDER BY t.creation_time",
